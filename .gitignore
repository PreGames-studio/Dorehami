# Build outputs — rebuilt on each machine (docs/GITHUB_SETUP.md section 2)
build/
.gradle/
.kotlin/

# IDE / editor settings
.idea/
*.iml
.vscode/

# Machine-local config (Android SDK path differs per machine)
local.properties

# Secrets — NEVER commit (signing keys, server tokens, database passwords)
*.jks
*.keystore
keystore.properties
.env
server.env

# Transfer-only artifact (zip used to move the architecture between computers)
dorehami-architecture.zip

# Android native build leftovers
captures/
.externalNativeBuild/
.cxx/

# OS junk
.DS_Store
Thumbs.db

# Dezhban Godot project (games/dejban/godot): editor cache and exports. These are the rules of the
# project's own .gitignore, which now sits in games/dejban/godot/standalone_repo/ (build/ and
# .DS_Store are already covered above).
games/dejban/godot/.godot/
games/dejban/godot/export/
games/dejban/godot/.venv/
games/dejban/godot/**/__pycache__/
games/dejban/godot/**/*.tmp
games/dejban/godot/**/*.apk
games/dejban/godot/**/*.aab
